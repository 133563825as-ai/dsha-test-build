+  @Test
+  public void acceptsBoundedFrameLagButNotTrulyStaleFrames() {
+    // see 之后光标闪烁把帧号推进几帧（约 4 帧/秒）仍然可以动作。
+    assertTrue(VirtualScreenPolicy.recent(7, 7, 1_000, 1_200));
+    assertTrue(VirtualScreenPolicy.recent(7, 7 + VirtualScreenPolicy.FRAME_LAG, 1_000, 1_200));
+    // 落后超过 FRAME_LAG、或超前于当前画面：真正的过期/伪造帧必须拒绝。
+    assertFalse(VirtualScreenPolicy.recent(7, 8 + VirtualScreenPolicy.FRAME_LAG, 1_000, 1_200));
+    assertFalse(VirtualScreenPolicy.recent(12, 7, 1_000, 1_200));
+    // 从未观察（新会话或动作已消耗观察）、观察到画面建立之前、观察超出时间窗。
+    assertFalse(VirtualScreenPolicy.recent(0, 7, 1_000, 1_200));
+    assertFalse(VirtualScreenPolicy.recent(-1, 7, 1_000, 1_200));
+    assertFalse(VirtualScreenPolicy.recent(7, 7, 0, 1_200));
+    assertFalse(
+        VirtualScreenPolicy.recent(
+            7, 7, 1_000, 1_000 + VirtualScreenPolicy.OBSERVATION_TTL_MS + 1));
+    // 画面静止时旧观察仍然有效：时间窗只兜住像素未变的上下文变化。
+    assertTrue(
+        VirtualScreenPolicy.recent(7, 7, 1_000, 1_000 + VirtualScreenPolicy.OBSERVATION_TTL_MS));
   }
