+  static final String MIME_ANY = "*/*";
+  private static final int MAX_ACCEPT = 16;
+  private static final int MAX_ACCEPT_LENGTH = 128;
+  private static final String[] REASON_CODES = {
+    "BAD_URI", "NO_STREAM", "FILE_TOO_LARGE", "TOTAL_TOO_LARGE"
+  };
+
+  private WebFilePick() {}
+
+  /** 系统「打开方式」列表；title 为空时用当前界面语言的默认标题。 */
+  static Intent chooser(List<String> accept, boolean multiple, String title) {
+    Intent pick =
+        new Intent(Intent.ACTION_OPEN_DOCUMENT)
+            .addCategory(Intent.CATEGORY_OPENABLE)
+            .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+    if (accept == null || accept.isEmpty()) {
+      pick.setType(MIME_ANY);
+    } else if (accept.size() == 1) {
+      pick.setType(accept.get(0));
+    } else {
+      pick.setType(MIME_ANY);
+      pick.putExtra(Intent.EXTRA_MIME_TYPES, accept.toArray(new String[0]));
+    }
+    if (multiple) pick.putExtra(Intent.EXTRA_ALLOW_MULTIPLE, true);
+    String label = title == null || title.isEmpty() ? UiText.choose("打开方式", "Open with") : title;
+    return Intent.createChooser(pick, label);
+  }
+
+  /** 请求里的 accept 白名单：只认 `type/subtype` 与通配，长度、条数都有界。 */
+  static List<String> accept(JSONArray types) {
+    List<String> list = new ArrayList<>();
+    if (types == null) return list;
+    for (int index = 0; index < types.length() && list.size() < MAX_ACCEPT; index++) {
+      String item = types.optString(index, "").trim();
+      if (item.isEmpty() || item.length() > MAX_ACCEPT_LENGTH) continue;
+      if (!MIME_ANY.equals(item) && !item.matches("[\\w.+-]+/(\\*|[\\w.+-]+)")) continue;
+      if (!list.contains(item)) list.add(item);
+    }
+    return list;
+  }
+
+  /** 内容 URI → `{name, mime, bytes, base64}`；只读上限内的字节。 */
+  static JSONObject read(Context context, Uri uri) throws IOException, JSONException {
+    if (uri == null || !"content".equals(uri.getScheme())) throw new IOException("BAD_URI");
+    String name = "attachment.bin";
+    try (Cursor cursor =
+        context
+            .getContentResolver()
+            .query(uri, new String[] {OpenableColumns.DISPLAY_NAME}, null, null, null)) {
+      if (cursor != null && cursor.moveToFirst())
+        name = WebTransferPolicy.fileName(cursor.getString(0));
+    } catch (RuntimeException error) {
+      // 取显示名失败不阻断读取：文件名只用于网页展示，不参与宿主路径拼装。
+    }
+    String mime = context.getContentResolver().getType(uri);
+    if (mime == null || mime.isEmpty()) mime = "application/octet-stream";
+    byte[] data;
+    try (InputStream input = context.getContentResolver().openInputStream(uri)) {
+      if (input == null) throw new IOException("NO_STREAM");
+      data = bounded(input, MAX_FILE_BYTES);
+    }
+    return new JSONObject()
+        .put("name", name)
+        .put("mime", mime)
+        .put("bytes", data.length)
+        .put("base64", android.util.Base64.encodeToString(data, android.util.Base64.NO_WRAP));
+  }
+
+  /** 多读一字节判超限：上限外的内容不进内存。 */
+  private static byte[] bounded(InputStream input, long limit) throws IOException {
+    ByteArrayOutputStream out = new ByteArrayOutputStream();
+    byte[] buffer = new byte[65536];
+    long total = 0;
+    int read;
+    while ((read = input.read(buffer)) != -1) {
+      total += read;
+      if (total > limit) throw new IOException("FILE_TOO_LARGE");
+      out.write(buffer, 0, read);
+    }
+    return out.toByteArray();
+  }
+
+  /** 回执 JSON；任何失败都退化成可辨识的 detail，不让回执本身抛异常。 */
+  static String payload(String id, boolean ok, JSONArray files, String detail) {
+    try {
+      JSONObject value = new JSONObject().put("v", 1).put("ok", ok);
+      if (id != null) value.put("id", id);
+      if (ok) value.put("files", files == null ? new JSONArray() : files);
+      else value.put("detail", detail == null || detail.isEmpty() ? "PICK_FAILED" : detail);
+      return value.toString();
+    } catch (JSONException error) {
+      return "{\"v\":1,\"ok\":false,\"detail\":\"PICK_FAILED\"}";
+    }
+  }
+
+  /** 失败原因：已知错误码原样透出，未知异常不把宿主细节带进网页。 */
+  static String reason(Exception error) {
+    String message = error == null ? null : error.getMessage();
+    if (message != null) for (String code : REASON_CODES) if (code.equals(message)) return code;
+    return "PICK_FAILED";
+  }
+}
