diff --git a/app/src/test/java/com/deepseekharness/app/util/VirtualScreenGenerationSyncTest.java b/app/src/test/java/com/deepseekharness/app/util/VirtualScreenGenerationSyncTest.java
new file mode 100644
index 0000000..2f2e3e1
--- /dev/null
+++ b/app/src/test/java/com/deepseekharness/app/util/VirtualScreenGenerationSyncTest.java
@@ -0,0 +1,39 @@
+package com.deepseekharness.app.util;
+
+import static org.junit.Assert.assertEquals;
+
+import org.junit.Test;
+
+public class VirtualScreenGenerationSyncTest {
+  @Test
+  public void commitsRemoteGenerationOnlyForDisplayChangingActions() {
+    assertEquals(
+        VirtualScreenGenerationSync.Decision.UNCHANGED,
+        VirtualScreenGenerationSync.decide("gen-a", "gen-a", false));
+    assertEquals(
+        VirtualScreenGenerationSync.Decision.UNCHANGED,
+        VirtualScreenGenerationSync.decide("gen-a", "gen-a", true));
+    // create 重建了 VirtualDisplay：远端新 generation 必须先提交，不能被判成过期。
+    assertEquals(
+        VirtualScreenGenerationSync.Decision.COMMIT,
+        VirtualScreenGenerationSync.decide("gen-a", "gen-b", true));
+    // 其余动作跨代次说明请求/响应错位：拒绝且不得改本地 generation。
+    assertEquals(
+        VirtualScreenGenerationSync.Decision.STALE,
+        VirtualScreenGenerationSync.decide("gen-a", "gen-b", false));
+  }
+
+  @Test
+  public void treatsMissingFieldsAsUnchanged() {
+    // 失败响应通常不带 generation：按原值处理，不能把错误响应当换代。
+    assertEquals(
+        VirtualScreenGenerationSync.Decision.UNCHANGED,
+        VirtualScreenGenerationSync.decide("gen-a", "", true));
+    assertEquals(
+        VirtualScreenGenerationSync.Decision.UNCHANGED,
+        VirtualScreenGenerationSync.decide("gen-a", null, true));
+    assertEquals(
+        VirtualScreenGenerationSync.Decision.UNCHANGED,
+        VirtualScreenGenerationSync.decide(null, "gen-a", true));
+  }
+}
