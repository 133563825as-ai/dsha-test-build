@@ -0,0 +1,28 @@
+package com.deepseekharness.app.util;
+
+/**
+ * 远端响应里的 generation 与本地管理器状态的合并规则；不依赖 Android。
+ *
+ * <p>只有改变 display 身份的动作（create 必然释放并重建 VirtualDisplay）可以把响应里的新
+ * generation 提交到本地；其余动作拿到不同 generation 说明请求与响应跨了代次，必须报过期。
+ */
+public final class VirtualScreenGenerationSync {
+  private VirtualScreenGenerationSync() {}
+
+  public enum Decision {
+    /** 响应与本代次一致（或缺省回落到本地值），不需要改动状态。 */
+    UNCHANGED,
+    /** display 身份改变的动作：先提交远端 generation，再评估其它检查。 */
+    COMMIT,
+    /** 请求与响应跨代次：必须拒绝，且不能改本地 generation。 */
+    STALE
+  }
+
+  public static Decision decide(String current, String returned, boolean displayChanging) {
+    if (returned == null
+        || returned.isEmpty()
+        || current == null
+        || current.equals(returned)) return Decision.UNCHANGED;
+    return displayChanging ? Decision.COMMIT : Decision.STALE;
+  }
+}
