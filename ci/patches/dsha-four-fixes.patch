+  /**
+   * glibc python 读取 wheel 的 dist-packages 目录。取法与 {@code adb-setup.sh} 的 SITE 一致
+   * （{@code site.getsitepackages()[0]} 即 {@code usr/local/lib/python<X.Y>/dist-packages}）：rootfs 里
+   * 存在的候选目录优先，都没有时返回带版本的首选目录，由安装流程按需创建。不要写死 Debian 的
+   * {@code usr/lib/python3/dist-packages} —— 本 rootfs 的 python 由随包 tarball 提供，该目录不存在，
+   * 写进去只会多出一层 python 不读取的目录。
+   */
+  public static File siteDir(File rootfsDir) {
+    List<String> candidates = siteCandidates(rootfsDir);
+    for (String candidate : candidates) {
+      File dir = new File(rootfsDir, candidate);
+      // 存在的目录直接用；不存在就交安装流程创建。被非目录项占用的位置留给文件系统按原样拒绝。
+      if (dir.isDirectory() || !dir.exists()) return dir;
+    }
+    return new File(rootfsDir, candidates.get(0));
+  }
+
+  /** 按 python 自身读取顺序给出候选：先 {@code usr/local/lib/python<X.Y>/dist-packages}。 */
+  private static List<String> siteCandidates(File rootfsDir) {
+    List<String> candidates = new ArrayList<>();
+    String version = pythonVersion(rootfsDir);
+    if (version != null) {
+      candidates.add("usr/local/lib/python" + version + "/dist-packages");
+      candidates.add("usr/lib/python" + version + "/dist-packages");
+    }
+    candidates.add("usr/lib/python3/dist-packages");
+    return candidates;
+  }
+
+  /** rootfs 里 glibc python 的主版本目录名（如 3.12）；查不到返回 null。 */
+  private static String pythonVersion(File rootfsDir) {
+    File[] dirs = new File(rootfsDir, "usr/lib").listFiles((d, n) -> n.matches("python3\\.[0-9]+"));
+    if (dirs == null || dirs.length == 0) return null;
+    Arrays.sort(dirs, Comparator.comparing(File::getName));
+    return dirs[dirs.length - 1].getName().substring("python".length());
+  }
