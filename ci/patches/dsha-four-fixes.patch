+   * 按 256 MiB 上限上传），所以这里超限直接报错，让插件回落到现状。
+   */
+  static final long MAX_FILE_BYTES = 4L * 1024 * 1024;
+
+  /** 一次请求的总原文上限，避免一次多选把网页内存顶满。 */
+  static final long MAX_TOTAL_BYTES = 8L * 1024 * 1024;
